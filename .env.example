# LexNova — Environment Variable Reference
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or any file with real secrets to Git.
# Use a secret manager (AWS Secrets Manager, GCP Secret Manager, HashiCorp Vault)
# for production credential management.
#
# Variables marked [REQUIRED] must be set for the application to start.
# Variables marked [OPTIONAL] have graceful fallbacks if unset.
# Variables marked [PRODUCTION] are required in production but optional in development.

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# [REQUIRED] Pooled connection URL — used for most queries (via PgBouncer)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# [REQUIRED] Direct connection URL — used for migrations (bypasses PgBouncer)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Authentication ─────────────────────────────────────────────────────────
# [REQUIRED] Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-minimum-secret-here

# [REQUIRED] Full URL of your app (no trailing slash)
NEXTAUTH_URL=https://your-domain.com

# [REQUIRED] Root admin email(s) — comma-separated, no spaces
# These accounts receive SUPER_ADMIN role automatically on login.
# SECURITY: Keep this secret. Rotate if compromised.
ROOT_ADMIN_EMAIL=admin@yourdomain.com

# ── Google OAuth (optional) ─────────────────────────────────────────────────
# [OPTIONAL] https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Providers ────────────────────────────────────────────────────────────
# [PRODUCTION] Primary AI provider — Anthropic Claude
# Get from: https://console.anthropic.com
# SECURITY: Never expose this key to the browser or commit to version control.
ANTHROPIC_API_KEY=sk-ant-...

# [OPTIONAL] Fallback AI provider — OpenAI GPT-4o
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── RAG / Vector Search ─────────────────────────────────────────────────────
# [OPTIONAL] Pinecone vector database for legal RAG
# Required to activate RAG legal research features
# Get from: https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_HOST=https://your-index-host.pinecone.io

# ── Supabase (Storage + Realtime) ────────────────────────────────────────────
# [REQUIRED for file uploads] Get from: Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# [REQUIRED for file uploads] Service role key — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# [PRODUCTION] Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=
# [PRODUCTION] Required to verify Razorpay webhook signatures
# Get from: Razorpay → Settings → Webhooks → Webhook Secret
RAZORPAY_WEBHOOK_SECRET=

# ── Redis Cache (Upstash) ────────────────────────────────────────────────────
# [OPTIONAL] Serverless Redis for rate limiting and caching
# Without this, the app uses an in-memory fallback (single-process only)
# Get from: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# [PRODUCTION] Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
# [PRODUCTION] Verified sender domain (configure in Resend dashboard first)
EMAIL_FROM=LexNova <noreply@lexnova.in>

# ── Error Monitoring (Sentry) ────────────────────────────────────────────────
# [OPTIONAL] Get from: https://sentry.io (create a Next.js project)
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=

# ── Application ──────────────────────────────────────────────────────────────
# [REQUIRED] Full public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# [REQUIRED] Node environment
NODE_ENV=production

# ── Feature Flags ────────────────────────────────────────────────────────────
# [OPTIONAL] Set to 'true' to enable features that are incomplete or experimental
# NEXT_PUBLIC_FEATURE_PAYMENTS=false
# NEXT_PUBLIC_FEATURE_RAG=false
# NEXT_PUBLIC_FEATURE_REALTIME=false

# ── Jitsi Video (optional) ───────────────────────────────────────────────────
# [OPTIONAL] Jitsi app ID for consultation room — uses meet.jit.si by default
JITSI_APP_ID=lexnova

# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION SECURITY CHECKLIST
# ═══════════════════════════════════════════════════════════════════════════════
#
# Before deploying to production:
#
# [ ] All [REQUIRED] and [PRODUCTION] variables are set
# [ ] NEXTAUTH_SECRET is ≥ 32 random characters (not reused from dev)
# [ ] ROOT_ADMIN_EMAIL is set to a real, monitored email address
# [ ] RAZORPAY_WEBHOOK_SECRET is configured and tested
# [ ] DATABASE_URL uses the pooled URL (pgbouncer=true)
# [ ] DIRECT_URL uses the non-pooled URL for migrations
# [ ] SUPABASE_SERVICE_ROLE_KEY is NOT prefixed with NEXT_PUBLIC_
# [ ] Anthropic and OpenAI keys have usage limits set in their dashboards
# [ ] Sentry is configured for production error tracking
# [ ] Git history has been scanned for accidentally committed secrets (git-secrets, trufflehog)
# [ ] .env and .env.local are in .gitignore
# [ ] Secrets are stored in a managed secret store (not plain environment files on the server)
# ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─── Core Models ──────────────────────────────────────────

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String             @unique
  emailVerified DateTime?
  passwordHash  String?
  role          String             @default("USER")
  city          String?
  phone         String?
  avatarUrl     String?
  isActive      Boolean            @default(true)
  loginAttempts Int                @default(0)
  lockedUntil   DateTime?
  orgId         String?
  org           Organization?      @relation(fields: [orgId], references: [id])
  subscription  Subscription?
  matters       Matter[]
  bookings      Booking[]
  documents     Document[]
  messages      Message[]
  advocate      Advocate?
  caseParties   CaseParty[]
  notifications CaseNotification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([email])
  @@index([orgId])
}

model Advocate {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id])
  name            String
  specialization  String
  barNumber       String?
  experienceYears Int         @default(0)
  languages       String      @default("English")
  city            String
  pricing         String
  availability    String      @default("Available")
  rating          Float       @default(0.0)
  reviewCount     Int         @default(0)
  verified        Boolean     @default(false)
  email           String?
  phone           String?
  calendarLink    String?
  availableDays   String      @default("MON,TUE,WED,THU,FRI")
  availableFrom   String      @default("10:00")
  availableTo     String      @default("18:00")
  consultationFee Float       @default(999)
  isAvailable     Boolean     @default(true)
  bio             String?
  photoUrl        String?
  courts          String?
  wins            Int         @default(0)
  bookings        Booking[]
  matters         Matter[]
  caseParties     CaseParty[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([city])
  @@index([specialization])
  @@index([verified])
}

model Matter {
  id                  String            @id @default(cuid())
  title               String
  description         String
  status              String            @default("ACTIVE")
  priority            String            @default("MEDIUM")
  jurisdiction        String
  category            String?
  caseType            String?
  urgency             String            @default("MEDIUM")
  complexity          String            @default("MEDIUM")
  lawyerType          String?
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  advocateId          String?
  advocate            Advocate?         @relation(fields: [advocateId], references: [id])
  orgId               String?
  org                 Organization?     @relation(fields: [orgId], references: [id])
  // ── Court tracking ─────────────────────────────
  caseNumber          String?           @unique
  courtName           String?
  courtCaseNum        String?
  filingDate          DateTime?
  nextHearingDate     DateTime?
  opposingPartyName   String?
  opposingPartyEmail  String?
  caseInviteToken     String?           @unique
  // ── Relations ──────────────────────────────────
  documents           Document[]
  timeline            TimelineEvent[]
  bookings            Booking[]
  messages            Message[]
  caseParties         CaseParty[]
  hearings            Hearing[]
  courtDocuments      CourtDocument[]
  evidence            Evidence[]
  limitationPeriod    LimitationPeriod?
  settlements         Settlement[]
  judgment            Judgment?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([advocateId])
  @@index([status])
  @@index([category])
  @@index([orgId])
}

model Document {
  id          String    @id @default(cuid())
  title       String
  type        String
  content     String?
  fileUrl     String?
  storagePath String?
  storageBucket String?
  mimeType    String?
  sizeBytes   Int?
  matterId    String
  matter      Matter    @relation(fields: [matterId], references: [id])
  uploaderId  String
  uploader    User      @relation(fields: [uploaderId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([matterId])
  @@index([uploaderId])
}

model TimelineEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  matterId    String
  matter      Matter    @relation(fields: [matterId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([matterId])
}

model Booking {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  advocateId        String
  advocate          Advocate  @relation(fields: [advocateId], references: [id])
  matterId          String?
  matter            Matter?   @relation(fields: [matterId], references: [id])

  date              String
  time              String
  duration          Int       @default(60)
  timezone          String    @default("Asia/Kolkata")

  status            String    @default("CONFIRMED")
  consultationType  String    @default("VIDEO")

  meetLink          String?
  meetPassword      String?

  userNotes         String?
  lawyerNotes       String?

  consultationFee   Float
  currency          String    @default("INR")
  paymentStatus     String    @default("PENDING")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  confirmationCode  String    @unique

  userEmailSent     Boolean   @default(false)
  lawyerEmailSent   Boolean   @default(false)
  reminderSent      Boolean   @default(false)

  cancelReason      String?
  cancelledBy       String?
  cancelledAt       DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([advocateId])
  @@index([paymentStatus])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  text      String
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([matterId])
  @@index([senderId])
}

// ─── Case Models ──────────────────────────────────────────

model CaseParty {
  id       String    @id @default(cuid())
  caseId   String
  matter   Matter    @relation(fields: [caseId], references: [id])
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  role     String    // "PLAINTIFF" | "DEFENDANT" | "WITNESS"
  lawyerId String?
  lawyer   Advocate? @relation(fields: [lawyerId], references: [id])
  joinedAt DateTime  @default(now())
  status   String    @default("ACTIVE")

  @@index([caseId])
  @@index([userId])
}

model Hearing {
  id            String    @id @default(cuid())
  caseId        String
  matter        Matter    @relation(fields: [caseId], references: [id])
  hearingDate   DateTime
  hearingTime   String
  courtName     String
  courtNumber   String?
  judgeName     String?
  purpose       String
  outcome       String?
  adjournReason String?
  nextDate      DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  reminderSent  Boolean   @default(false)

  @@index([caseId])
  @@index([hearingDate])
}

model CourtDocument {
  id            String   @id @default(cuid())
  caseId        String
  matter        Matter   @relation(fields: [caseId], references: [id])
  title         String
  type          String
  filedBy       String
  fileUrl       String?
  storagePath   String?
  content       String?
  isShared      Boolean  @default(false)
  filingDate    DateTime @default(now())
  courtReceived Boolean  @default(false)
  exhibitNumber String?
  uploadedById  String
  createdAt     DateTime @default(now())

  @@index([caseId])
}

model Evidence {
  id              String   @id @default(cuid())
  caseId          String
  matter          Matter   @relation(fields: [caseId], references: [id])
  title           String
  description     String
  fileUrl         String?
  storagePath     String?
  fileType        String?
  uploadedById    String
  party           String
  exhibitNum      String?
  admittedByCourt Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([caseId])
}

model LimitationPeriod {
  id             String   @id @default(cuid())
  caseId         String   @unique
  matter         Matter   @relation(fields: [caseId], references: [id])
  caseType       String
  filingDeadline DateTime
  warningDays    Int[]    @default([30, 15, 7, 1])
  warningsSent   Int[]    @default([])
  isExpired      Boolean  @default(false)
  legalBasis     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Settlement {
  id                String    @id @default(cuid())
  caseId            String
  matter            Matter    @relation(fields: [caseId], references: [id])
  proposedBy        String
  terms             String
  amount            Float?
  status            String    @default("PROPOSED")
  signedByPlaintiff Boolean   @default(false)
  signedByDefendant Boolean   @default(false)
  signedAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([caseId])
}

model Judgment {
  id              String    @id @default(cuid())
  caseId          String    @unique
  matter          Matter    @relation(fields: [caseId], references: [id])
  judgmentDate    DateTime
  judgeName       String
  outcome         String
  orderText       String
  plainEnglish    String
  amountAwarded   Float?
  executionStatus String    @default("PENDING")
  appealDeadline  DateTime?
  createdAt       DateTime  @default(now())
}

model CaseNotification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  caseId      String
  type        String
  title       String
  message     String
  channel     String    @default("APP")
  isRead      Boolean   @default(false)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
}

// ─── SaaS / Billing Models ────────────────────────────────

model Plan {
  id                    String         @id @default(cuid())
  name                  String         @unique // "FREE" | "PROFESSIONAL" | "ENTERPRISE"
  displayName           String
  priceMonthly          Float
  priceYearly           Float
  aiChatsLimit          Int            @default(5)     // -1 = unlimited
  documentsLimit        Int            @default(2)
  advocateBookingsLimit Int            @default(0)
  apiAccess             Boolean        @default(false)
  features              String[]       @default([])
  razorpayPlanId        String?
  subscriptions         Subscription[]
  createdAt             DateTime       @default(now())
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  status           String    @default("ACTIVE") // "ACTIVE" | "CANCELLED" | "PAST_DUE" | "TRIALING"
  currentPeriodStart DateTime
  currentPeriodEnd DateTime
  razorpaySubId    String?
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model UsageQuota {
  id          String   @id @default(cuid())
  userId      String   @unique
  periodStart DateTime
  periodEnd   DateTime
  aiChatsUsed Int      @default(0)
  docsUsed    Int      @default(0)
  bookingsUsed Int     @default(0)
  updatedAt   DateTime @updatedAt
}

// ─── Enterprise / Multi-Tenancy ───────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("STARTUP") // "STARTUP" | "BUSINESS" | "ENTERPRISE"
  apiKey    String   @unique @default(cuid())
  members   User[]
  cases     Matter[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([apiKey])
}

// ─── Auth helpers ─────────────────────────────────────────

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String   // "EMAIL_VERIFY" | "PASSWORD_RESET"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}
